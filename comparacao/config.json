{
  "version": 1,
  "corpus": "graphrag/data",
  "provider": "openai",
  "llm_model": "gpt-4o-mini",
  "embedding_provider": "openai",
  "embedding_model": "text-embedding-3-small",
  "embedding_device": "cpu",
  "embedding_batch_size": 128,
  "embedding_max_length": 8192,
  "chunk_size": 1024,
  "chunk_overlap": 200,
  "parent_size": 3200,
  "top_k": 5,
  "retrieval_mode": "hybrid",
  "candidate_pool": 50,
  "rrf_k": 60,
  "max_per_table": 2,
  "reranker": "BAAI/bge-reranker-v2-m3",
  "rerank_pool": 30,
  "min_text_chars": 250,
  "small_table_rows": 30,
  "small_table_chars": 6000,
  "context_tokens": 12000,
  "max_output_tokens": 1200,
  "temperature": 0.0,
  "entity_context_limit": 8,
  "entity_context_depth": 1,
  "graph_context_limit": 6,
  "graph_context_depth": 2,
  "community_summary_chars": 1800
}
