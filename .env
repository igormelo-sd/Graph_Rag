# rag_base — RAG principal isolado (só rag_principal, sem as outras 3 variantes)
# Preencha MARITACA_API_KEY antes de rodar. Demais chaves opcionais (fallback).
RAG_LLM_PROVIDER=maritaca
RAG_LLM_MODEL=sabia-4
RAG_INTERP_MODEL=sabiazinho-4
RAG_LLM_RERANK=1
RAG_INGEST_LLM_ENRICHMENT=0

MARITACA_API_KEY=
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENROUTER_API_KEY=

# Embedding local (todo o embedding roda aqui, sem nuvem na vetorização)
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=200
RAG_SMALL_TABLE_MAX_ROWS=10
RAG_BGE_RERANK=1

# chroma_db/ veio vazio nesta cópia -> primeiro boot re-vetoriza (~23min CPU).
# Depois do primeiro boot, troque para RAG_INDEX_READ_ONLY=1.
RAG_INDEX_AUTO_DOWNLOAD=0
RAG_INDEX_READ_ONLY=0

# Grafo desligado por padrão (igual ao compose)
RAG_GRAPH_EMBED=0
RAG_GRAPH_STRUCT=1
RAG_VISION=0
RAG_RAPTOR_ENABLE=0
