# RAG principal — provedor padrão: OpenAI (alternativa: OpenRouter)
# Preencha OPENAI_API_KEY antes de rodar (ou OPENROUTER_API_KEY com RAG_LLM_PROVIDER=openrouter).
RAG_LLM_PROVIDER=openai
RAG_LLM_MODEL=gpt-5-chat-latest
RAG_INTERP_MODEL=gpt-5-mini
RAG_LLM_RERANK=1
RAG_INGEST_LLM_ENRICHMENT=0

OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENROUTER_API_KEY=

# Embedding local (todo o embedding roda aqui, sem nuvem na vetorização)
RAG_EMBED_MODEL=BAAI/bge-m3
RAG_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=200
RAG_SMALL_TABLE_MAX_ROWS=10
RAG_BGE_RERANK=1

# chroma_db/ veio vazio nesta cópia -> primeiro boot re-vetoriza (~23min CPU).
# Depois do primeiro boot, troque para RAG_INDEX_READ_ONLY=1.
RAG_INDEX_AUTO_DOWNLOAD=0
RAG_INDEX_READ_ONLY=0

# Grafo desligado por padrão (igual ao compose)
RAG_GRAPH_EMBED=0
RAG_GRAPH_STRUCT=1
RAG_VISION=0
RAG_RAPTOR_ENABLE=0
